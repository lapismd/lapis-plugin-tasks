{
  "validation:all": "node scripts/validation/all.mjs",
  "build": "pnpm build:native && pnpm run prepack",
  "check": "pnpm check:validation-routing && pnpm check:storybook-parity && pnpm spec:validate && pnpm check:app-ownership && pnpm check:no-tailwind && pnpm check:svelte && pnpm check:types && pnpm check:native",
  "check:app-ownership": "vitest run --project unit src/lib/application-ownership.test.ts",
  "check:no-tailwind": "node scripts/check-no-tailwind.mjs",
  "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
  "check:types": "tsc -p tsconfig.node.json --noEmit",
  "test": "pnpm test:native && vitest run --project unit --passWithNoTests --maxWorkers=1 --no-file-parallelism",
  "test:storybook": "node scripts/test-storybook-batches.mjs",
  "build-storybook": "NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" storybook build --config-dir .storybook --output-dir storybook-static",
  "publint": "pnpm run prepack",
  "prepack": "svelte-package --tsconfig ./tsconfig.pack.json && publint",
  "spec:build": "node scripts/dependency-automation/spec-policy.mjs build",
  "spec:check": "pnpm check:validation-routing && pnpm check:storybook-parity && node scripts/dependency-automation/spec-policy.mjs check && pnpm check:app-ownership",
  "spec:first": "node scripts/dependency-automation/spec-policy.mjs first",
  "spec:validate": "node scripts/dependency-automation/spec-policy.mjs validate",
  "build:native": "CARGO_BUILD_JOBS=1 CARGO_INCREMENTAL=0 cargo build --locked --manifest-path crates/lapis-task-services/Cargo.toml",
  "check:native": "CARGO_BUILD_JOBS=1 CARGO_INCREMENTAL=0 cargo clippy --locked --manifest-path crates/lapis-task-services/Cargo.toml --all-targets -- -D warnings && cargo fmt --manifest-path crates/lapis-task-services/Cargo.toml -- --check",
  "test:native": "CARGO_BUILD_JOBS=1 CARGO_INCREMENTAL=0 cargo test --locked --manifest-path crates/lapis-task-services/Cargo.toml",
  "check:validation-routing": "node scripts/validation/check-routing.mjs",
  "check:storybook-parity": "node scripts/spec-validation/check-storybook-parity.mjs",
  "validation:check": "vitest run --project unit scripts/validation.test.mjs scripts/spec-validation/storybook-parity.test.mjs --maxWorkers=1 --no-file-parallelism",
  "validation:smoke": "node scripts/validation/smoke.mjs",
  "capture:native-lifecycle-reference": "LAPIS_TASKS_CAPTURE_LIFECYCLE=1 vitest run --project unit src/lib/model/native-lifecycle-reference.test.ts --maxWorkers=1 --no-file-parallelism",
  "test:native-lifecycle-reference": "vitest run --project unit src/lib/model/native-lifecycle-reference.test.ts --maxWorkers=1 --no-file-parallelism",
  "release:prepare": "pnpm run prepack && node scripts/release.mjs prepare",
  "ci:governance": "pnpm spec:check && pnpm spec:validate",
  "ci:quality": "pnpm check:no-tailwind && pnpm check:svelte && pnpm check:types",
  "ci:unit": "vitest run --project unit --passWithNoTests --maxWorkers=1 --no-file-parallelism",
  "ci:native": "pnpm check:native && pnpm test:native && pnpm build:native",
  "ci:storybook-static": "pnpm build-storybook",
  "ci:storybook-interaction-1": "node scripts/test-storybook-batches.mjs -- --shard=1/3",
  "ci:storybook-interaction-2": "node scripts/test-storybook-batches.mjs -- --shard=2/3",
  "ci:storybook-interaction-3": "node scripts/test-storybook-batches.mjs -- --shard=3/3",
  "ci:release-prepare": "pnpm run prepack && node scripts/release.mjs prepare",
  "registry:prepare": "pnpm build:bundle && node scripts/registry-release.mjs prepare .release/runtime",
  "registry:media:capture": "node scripts/registry-media.mjs",
  "registry:media:check": "node scripts/registry-media.mjs --check",
  "registry:check": "vitest run --project unit scripts/registry-*.test.mjs --maxWorkers=1 --no-file-parallelism",
  "build:bundle": "node scripts/build-plugin-bundle.mjs",
  "registry:runtime:check": "pnpm registry:prepare && node scripts/registry-runtime-smoke.mjs"
}
