{
  "name": "@lapis-notes/lapis-plugin-tasks",
  "version": "0.1.0",
  "description": "Lapis Notes Tasks planner, indexing, and catalog",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/lapis-plugin-tasks.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/validation.mjs run build",
    "check": "node scripts/validation.mjs run check",
    "check:app-ownership": "node scripts/validation.mjs run check:app-ownership",
    "check:no-tailwind": "node scripts/validation.mjs run check:no-tailwind",
    "check:svelte": "node scripts/validation.mjs run check:svelte",
    "check:types": "node scripts/validation.mjs run check:types",
    "test": "node scripts/validation.mjs run test",
    "test:storybook": "node scripts/validation.mjs run test:storybook",
    "build-storybook": "node scripts/validation.mjs run build-storybook",
    "publint": "node scripts/validation.mjs run publint",
    "prepack": "node scripts/validation.mjs run prepack",
    "spec:build": "node scripts/validation.mjs run spec:build",
    "spec:check": "node scripts/validation.mjs run spec:check",
    "spec:first": "node scripts/validation.mjs run spec:first",
    "spec:validate": "node scripts/validation.mjs run spec:validate",
    "storybook": "WATCHPACK_POLLING=250 node scripts/storybook-run.mjs --no-open --config-dir .storybook",
    "storybook:stop": "bash scripts/storybook-stop.sh",
    "storybook:restart": "bash scripts/storybook-restart.sh",
    "build:native": "node scripts/validation.mjs run build:native",
    "check:native": "node scripts/validation.mjs run check:native",
    "test:native": "node scripts/validation.mjs run test:native",
    "check:validation-routing": "node scripts/validation.mjs run check:validation-routing",
    "check:storybook-parity": "node scripts/validation.mjs run check:storybook-parity",
    "validation:check": "node scripts/validation.mjs run validation:check",
    "validation:all": "node scripts/validation.mjs run validation:all",
    "validation:smoke": "node scripts/validation.mjs run validation:smoke",
    "validation": "node scripts/validation.mjs",
    "validation:doctor": "node scripts/validation.mjs doctor",
    "validation:images": "node scripts/validation.mjs images",
    "validation:clean": "node scripts/validation.mjs clean",
    "capture:native-lifecycle-reference": "node scripts/validation.mjs run capture:native-lifecycle-reference",
    "test:native-lifecycle-reference": "node scripts/validation.mjs run test:native-lifecycle-reference",
    "spec:search": "spec-validator search",
    "spec:index": "spec-validator index",
    "changeset": "changeset",
    "release:version": "node scripts/release.mjs version",
    "release:prepare": "node scripts/validation.mjs run release:prepare",
    "release:publish": "node scripts/release.mjs publish",
    "release:verify": "node scripts/release.mjs verify",
    "release:attest": "node scripts/release.mjs attest"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.stories.*",
    "!dist/**/*.example-sources.*",
    "!dist/**/*.story-play.*",
    "manifest.json",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "dependencies": {
    "@dnd-kit/helpers": "0.4.0",
    "@dnd-kit/svelte": "0.4.0",
    "@internationalized/date": "3.12.4",
    "@lezer/common": "1.5.5",
    "@lezer/markdown": "1.8.1",
    "@lucide/svelte": "^0.523.0",
    "bits-ui": "2.20.2",
    "chrono-node": "^2.10.1",
    "rrule": "2.8.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lapis-notes/api": "^0.2.0",
    "@lapismd/design-core": "^0.7.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/source-code-pro": "5.2.7",
    "@lapis-notes/api": "^0.2.0",
    "@lapis-notes/file-explorer": "^0.2.0",
    "@lapis-notes/markdown": "^0.2.0",
    "@lapis-notes/search": "^0.1.4",
    "@lapis-notes/ui": "^0.1.4",
    "@lapis-notes/workspace": "^0.3.0",
    "@lapismd/design-core": "^0.7.1",
    "@lapismd/mira": "~0.1.2",
    "@lapismd/spec-validator": "^0.2.0",
    "@lezer/highlight": "1.2.5",
    "@lezer/lr": "1.4.12",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-svelte-csf": "5.1.2",
    "@storybook/addon-themes": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/svelte-vite": "10.6.5",
    "@sveltejs/package": "2.5.0",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tailwindcss/vite": "4.1.12",
    "@tsconfig/svelte": "5.0.5",
    "@types/node": "^24.10.0",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "aria-query": "5.3.2",
    "publint": "0.3.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.6.5",
    "svelte": "5.56.10",
    "svelte-check": "4.3.1",
    "tailwindcss": "4.1.12",
    "typescript": "~5.9.3",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "@changesets/cli": "^3.0.3",
    "@dnd-kit/dom": "0.4.0",
    "sigstore": "4.1.1"
  }
}
