{
  "id": "tasks",
  "name": "Tasks",
  "version": "0.1.2",
  "minAppVersion": "0.0.1",
  "description": "Vault-native Tasks planner, indexing, and queries.",
  "author": "Lapis Notes",
  "distribution": "first-party-external",
  "provenance": "official",
  "enabledByDefault": true,
  "lapis": {
    "manifestVersion": 1,
    "runtime": {
      "entries": {
        "workspace": {
          "path": "main.mjs",
          "format": "esm",
          "sharedDependencies": [
            "@codemirror/state",
            "@codemirror/view",
            "@lapis-notes/api",
            "@lapis-notes/api/app-database",
            "@lapis-notes/api/native-tasks",
            "@lapis-notes/api/workspace-host",
            "@lapismd/design-core/shadcn/alert",
            "@lapismd/design-core/shadcn/badge",
            "@lapismd/design-core/shadcn/button",
            "@lapismd/design-core/shadcn/code-block",
            "@lapismd/design-core/shadcn/command",
            "@lapismd/design-core/shadcn/dialog",
            "@lapismd/design-core/shadcn/dropdown-menu",
            "@lapismd/design-core/shadcn/field",
            "@lapismd/design-core/shadcn/file-type-icon",
            "@lapismd/design-core/shadcn/input",
            "@lapismd/design-core/shadcn/popover",
            "@lapismd/design-core/shadcn/scroll-area",
            "@lapismd/design-core/shadcn/separator",
            "@lapismd/design-core/shadcn/sheet",
            "@lapismd/design-core/shadcn/switch",
            "@lapismd/design-core/shadcn/textarea",
            "@lapismd/design-core/shadcn/toggle-group",
            "@lapismd/design-core/shadcn/tooltip",
            "svelte/renderer/5.56.10",
            "svelte/renderer/5.56.10/attachments",
            "svelte/renderer/5.56.10/events",
            "svelte/renderer/5.56.10/internal/client",
            "svelte/renderer/5.56.10/internal/disclose-version",
            "svelte/renderer/5.56.10/reactivity",
            "svelte/renderer/5.56.10/store"
          ],
          "requiresReloadOnUpdate": false
        }
      }
    }
  }
}
